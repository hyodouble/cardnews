# GitHub Pages root that serves img/ -- no trailing slash
BASE_URL=https://hyodouble.github.io/cardnews

# One long-lived page token drives both Facebook and Instagram publishing
PAGE_TOKEN=

# Facebook page What's Hot Korea (Graph API id, not the profile.php number)
FB_PAGE_ID=1253255244544447

# Instagram business account whatshotkorea
IG_USER_ID=17841435489644683

# Threads profile @whatshotkorea -- separate API, separate token
THREADS_USER_ID=
THREADS_TOKEN=

# Only needed when refreshing PAGE_TOKEN with refresh_token.py.
# USER_TOKEN is the short-lived token from the OAuth dialog; it is consumed
# once and can be blanked afterwards.
APP_ID=
APP_SECRET=
USER_TOKEN=
